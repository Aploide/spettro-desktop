{
  "name": "spettro-desktop",
  "version": "0.1.5",
  "description": "Spettro for Linux and Windows — a desktop UI for the spettro command-line agent",
  "main": "./out/main/index.js",
  "author": "Carlo Esposito - Eyed",
  "license": "GPL-3.0",
  "homepage": "https://spettro.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/aploide/spettro-Desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "rebuild:native": "electron-builder install-app-deps",
    "pack:linux": "electron-vite build && electron-builder --linux --x64 --arm64",
    "pack:win": "electron-vite build && electron-builder --win --x64 --arm64",
    "pack": "electron-vite build && electron-builder",
    "visual": "vite build -c tools/visual/vite.config.ts && electron --no-sandbox tools/visual/capture.cjs .visual-dist .visual-shots",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "bonjour-service": "^1.3.0",
    "marked": "^15.0.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  }
}
