{
  "name": "spettro-desktop",
  "version": "2.6.8",
  "description": "Spettro for Linux and Windows — a desktop UI for the spettro command-line agent",
  "main": "./out/main/index.js",
  "author": "Carlo Esposito",
  "license": "MIT",
  "homepage": "https://spettro.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesp99/Spettro-Desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:native": "electron-builder install-app-deps",
    "pack:linux": "electron-vite build && electron-builder --linux --x64 --arm64",
    "pack:win": "electron-vite build && electron-builder --win --x64 --arm64",
    "pack": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "bonjour-service": "^1.3.0",
    "marked": "^15.0.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
